formulas:
  Sin título: ""
views:
  - type: cards
    name: Card
    filters:
      and:
        - file.folder.startsWith("9000 - Ω - Harkaive/9100 - Bookshelf/Books")
    order:
      - file.name
      - author
      - pages
    sort:
      - property: file.name
        direction: DESC
    image: note.cover
    cardSize: 170
    imageFit: contain
    imageAspectRatio: 1.5
